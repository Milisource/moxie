# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
moxie
.codegraph
workflow.log
workflow2.log
workflow3.log
ci.log
dist
scripts/release.sh

# Desktop (Wails) build artifacts
desktop/build/bin/
desktop/build/dist/
desktop/build/windows/icon.ico
# Generated by scripts/package-windows.ps1 (per-build values)
desktop/build/windows/installer/moxie_build.nsh
desktop/build/windows/installer/moxie-cli-*.exe
# frontend/dist is generated, but a committed .gitkeep must survive so the
# `//go:embed all:frontend/dist` in desktop/main.go matches on a fresh clone
# (CI runs `go build ./...` before any frontend build). The bare `dist` rule
# above also matches this directory, so re-include it first.
!desktop/frontend/dist/
desktop/frontend/dist/*
!desktop/frontend/dist/.gitkeep
desktop/frontend/node_modules/
desktop/desktop

# Echoes memory vault + opencode local tooling state
EchoesVault/
.opencode/commands/
.opencode/echoes-state.json
.opencode/skills/echoes-append-to-daily-log/
.opencode/skills/echoes-create-or-update-page/
.opencode/skills/echoes-search-vault-pages/

# Scraper work products (downloaded site-theme assets, accidentally committed once)
internal/css.css
internal/style.css
