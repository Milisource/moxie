{
  "manifest_version": 3,
  "name": "moxie-bridge",
  "version": "0.1.0",
  "description": "Reports F95Zone download destinations to a local moxie instance after the browser check.",
  "permissions": ["tabs", "storage"],
  "host_permissions": ["https://f95zone.to/*", "http://127.0.0.1/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://f95zone.to/dl/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
